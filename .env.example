# Local: nexolu-pos-api corriendo con `php artisan serve` (puerto 8000 por defecto).
# Produccion: https://pos-backend.nexolu.co/api/v1 (ver nexolu-infra/README.md).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# License key de PrimeVue (tier community/dev) - se pasa como opcion
