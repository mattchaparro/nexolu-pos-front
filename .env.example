# muestra un watermark "Invalid PrimeUI License" en toda la app.
VITE_PRIMEVUE_LICENSE_KEY=eyJpZCI6ImRjM2ZhYzMzLTE5YjEtNDE5MC1iODlkLWQ0YTRmZmQxYWQ1ZCIsInByb2R1Y3QiOiJwcmltZXVpIiwidGllciI6ImNvbW11bml0eSIsInR5cGUiOiJkZXYiLCJpYXQiOjE3ODU5ODAxMzYsImV4cCI6MTgxNzUxNjEzNn0.QgRmovVksiMLDmI-pkjrfGdX-OHbSL11p6eZJU6EEf9HFhLRmN6CRDaxmuaKRPmtKJ2-_Qocbm4vk0P9bpwSDQ

# --- Sentry (error tracking, optional) ---
# Dejar VACIO fuera de produccion - a diferencia del backend
# (nexolu-pos-api/config/sentry.php resuelve el ambiente en tiempo de
# ejecucion), este DSN queda CONGELADO en el bundle compilado al hacer
# `npm run build` - no hay forma de "apagarlo" despues para un ambiente
# dado, la unica defensa es no compilarlo con un valor fuera de
# produccion. Mismo tracesSampleRate que SENTRY_TRACES_SAMPLE_RATE del
# backend (nexolu-pos-api/.env) para poder cruzar trazas de front y back
# de la misma request.
VITE_SENTRY_DSN_PUBLIC=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
